# Скопируйте в server/.env и задайте свои значения
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=project_management
DB_USER=postgres
DB_PASSWORD=postgres
# true — синхронизировать модели Sequelize при старте (только для разработки)
DB_AUTO_SYNC=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Каталог для вложений задач (по умолчанию ./uploads)
# UPLOAD_DIR=./uploads
